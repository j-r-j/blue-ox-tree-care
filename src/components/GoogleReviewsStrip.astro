---
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import { withBase } from '../lib/paths';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
---

<section
  class:list={[
    'border-y',
    isDark ? 'border-white/10 bg-ox-navy text-white' : 'border-ox-navy/10 bg-ox-cream text-ox-navy',
  ]}
  aria-labelledby="google-reviews-heading"
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-ox-gold">Google reviews</p>
        <h2 id="google-reviews-heading" class="mb-2 text-2xl font-bold">
          {reviews.rating.toFixed(1)} stars · {reviews.count} Google reviews
        </h2>
        <p class:list={['text-sm', isDark ? 'text-white/80' : 'text-ox-navy/75']}>
          Real ratings from our Google Business Profile — Blue Ox Tree Care, Austin TX.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={site.googleProfile}
          class="rounded-md bg-ox-gold px-5 py-2.5 text-center text-sm font-semibold text-ox-navy transition hover:bg-ox-gold-dark"
          rel="noopener noreferrer"
          target="_blank"
        >
          Read Google reviews
        </a>
        <a
          href={site.googleProfile}
          class:list={[
            'rounded-md border-2 px-5 py-2.5 text-center text-sm font-semibold transition',
            isDark
              ? 'border-white/40 text-white hover:bg-white/10'
              : 'border-ox-navy/20 text-ox-navy hover:border-ox-blue hover:text-ox-blue',
          ]}
          rel="noopener noreferrer"
          target="_blank"
        >
          Write a review
        </a>
      </div>
    </div>

    {reviews.quotes.length > 0 && (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.quotes.map((quote) => (
          <blockquote
            class:list={[
              'rounded-lg border p-5',
              isDark ? 'border-white/10 bg-white/5' : 'border-ox-navy/10 bg-white shadow-sm',
            ]}
          >
            <p class="mb-3 text-sm italic">&ldquo;{quote.text}&rdquo;</p>
            <footer class="text-xs font-semibold text-ox-gold">{quote.author}</footer>
          </blockquote>
        ))}
      </div>
    )}
  </div>
</section>
