---
import type { ServiceArea } from '../data/serviceAreas';
import { withBase } from '../lib/paths';

interface Props {
  area: ServiceArea;
  headingLevel?: 'h2' | 'h3';
}

const { area, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="group relative flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:border-ox-gold hover:shadow-md">
  <Heading class="mb-2 font-sans text-lg font-semibold text-ox-navy">
    <a
      href={withBase(`/service-areas/${area.slug}`)}
      class="after:absolute after:inset-0 after:rounded-lg group-hover:text-ox-blue-dark"
    >
      Tree care in {area.name}
    </a>
  </Heading>
  <p class="mb-4 line-clamp-3 flex-1 text-sm text-ox-navy/80">{area.description}</p>
  <span class="text-sm font-semibold text-ox-blue-dark group-hover:underline" aria-hidden="true">
    View area <span>→</span>
  </span>
</article>
