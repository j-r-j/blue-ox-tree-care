---
import type { ServiceArea } from '../data/serviceAreas';
import { withBase } from '../lib/paths';

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
---

<article class="flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:shadow-md">
  <h3 class="mb-2 text-lg font-semibold text-ox-navy">
    <a href={withBase(`/service-areas/${area.slug}`)} class="hover:text-ox-blue">
      {area.name}
    </a>
  </h3>
  <p class="mb-4 line-clamp-3 flex-1 text-sm text-ox-navy/80">{area.description}</p>
  <a
    href={withBase(`/service-areas/${area.slug}`)}
    class="text-sm font-medium text-ox-gold hover:text-ox-gold-dark hover:underline"
  >
    View area →
  </a>
</article>
