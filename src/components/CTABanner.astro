---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  heading?: string;
  subtext?: string;
  contactLabel?: string;
}

const {
  heading = 'Ready to schedule tree care?',
  subtext = 'Call for a consultation or request an estimate for your Austin-area property.',
  contactLabel = 'Contact Us',
} = Astro.props;
---

<section class="bg-ox-navy py-12 text-white">
  <div class="mx-auto max-w-4xl px-4 text-center">
    <h2 class="mb-3 text-2xl font-bold md:text-3xl">{heading}</h2>
    <p class="mb-6 text-white/90">{subtext}</p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={`tel:${site.phoneTel}`}
        class="rounded-md bg-ox-gold px-6 py-3 font-semibold text-ox-navy transition hover:bg-ox-gold-dark"
      >
        Call {site.phone}
      </a>
      <a
        href={withBase('/contact')}
        class="rounded-md border-2 border-white px-6 py-3 font-semibold text-white transition hover:bg-white/10"
      >
        {contactLabel}
      </a>
    </div>
  </div>
</section>
