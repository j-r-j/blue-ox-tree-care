---
import type { Service } from '../data/services';
import { withBase } from '../lib/paths';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = withBase(`/services/${service.slug}`);
---

<article class="group relative flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:border-ox-gold hover:shadow-md">
  <Heading class="mb-2 font-sans text-lg font-semibold text-ox-navy">
    <a href={href} class="after:absolute after:inset-0 after:rounded-lg group-hover:text-ox-blue-dark">
      {service.shortTitle}
    </a>
  </Heading>
  <p class="mb-4 flex-1 text-sm text-ox-navy/80">{service.description}</p>
  <span class="text-sm font-semibold text-ox-blue-dark group-hover:underline" aria-hidden="true">
    Learn more <span>→</span>
  </span>
</article>
