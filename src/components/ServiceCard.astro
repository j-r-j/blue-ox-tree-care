---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:shadow-md">
  <h3 class="mb-2 text-lg font-semibold text-ox-navy">
    <a href={`/services/${service.slug}`} class="hover:text-ox-green">
      {service.shortTitle}
    </a>
  </h3>
  <p class="mb-4 flex-1 text-sm text-ox-navy/80">{service.description}</p>
  <a
    href={`/services/${service.slug}`}
    class="text-sm font-medium text-ox-green hover:underline"
  >
    Learn more →
  </a>
</article>
