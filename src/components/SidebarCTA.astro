---
import { site } from '../data/site';
import { estimateFormPath } from '../data/leadForm';
import { withBase } from '../lib/paths';

interface Props {
  heading?: string;
}

const { heading = 'Get a free estimate' } = Astro.props;
---

<div class="hidden rounded-lg border-t-4 border-ox-gold bg-ox-navy p-6 text-white shadow-sm lg:block">
  <h2 class="mb-1 text-lg font-bold text-white">{heading}</h2>
  <p class="mb-4 text-sm text-white/80">You talk with an ISA certified arborist.</p>
  <a href={withBase(estimateFormPath)} class="btn-primary mb-2 block px-4 py-3 text-center">
    Get a Free Estimate
  </a>
  <a
    href={`tel:${site.phoneTel}`}
    class="block rounded-md border-2 border-white/70 px-4 py-2.5 text-center font-semibold text-white transition hover:bg-white/10"
  >
    Call {site.phone}
  </a>
  <p class="mt-3 text-center text-xs text-white/70">{site.hours.short}</p>
</div>
