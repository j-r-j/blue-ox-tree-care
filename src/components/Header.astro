---
import { site } from '../data/site';
import { services } from '../data/services';
import { serviceAreas } from '../data/serviceAreas';
import { getGuideNavItems } from '../data/guides';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const guideNavItems = getGuideNavItems();

function isActive(href: string) {
  const target = withBase(href);
  if (href === '/') {
    return currentPath === target || currentPath === target.replace(/\/$/, '');
  }
  return currentPath.startsWith(target.replace(/\/$/, ''));
}
---

<header class="sticky top-0 z-50 bg-ox-navy text-white shadow-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={withBase('/')} class="flex items-center gap-3 no-underline">
      <picture>
        <source srcset={withBase('/logo-ox.webp')} type="image/webp" />
        <img
          src={withBase('/logo-ox.png')}
          alt="Blue Ox Tree Care"
          width="44"
          height="44"
          class="h-11 w-11 shrink-0 object-contain"
          loading="eager"
        />
      </picture>
      <span class="text-lg font-bold leading-tight tracking-tight text-white">Blue Ox Tree Care</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
      <div class="group relative">
        <a
          href={withBase('/services')}
          class:list={[
            'text-sm font-medium transition hover:text-ox-gold',
            isActive('/services') ? 'text-ox-gold' : 'text-white',
          ]}
        >
          Services
        </a>
        <div class="invisible absolute left-0 top-full z-50 min-w-[220px] pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-md bg-white py-2 shadow-lg">
            {services.map((service) => (
              <a
                href={withBase(`/services/${service.slug}`)}
                class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream"
              >
                {service.shortTitle}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="group relative">
        <a
          href={withBase('/service-areas')}
          class:list={[
            'text-sm font-medium transition hover:text-ox-gold',
            isActive('/service-areas') ? 'text-ox-gold' : 'text-white',
          ]}
        >
          Service Areas
        </a>
        <div class="invisible absolute left-0 top-full z-50 min-w-[200px] pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-md bg-white py-2 shadow-lg">
            {serviceAreas.map((area) => (
              <a
                href={withBase(`/service-areas/${area.slug}`)}
                class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream"
              >
                {area.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="group relative">
        <a
          href={withBase('/guides')}
          class:list={[
            'text-sm font-medium transition hover:text-ox-gold',
            isActive('/guides') ? 'text-ox-gold' : 'text-white',
          ]}
        >
          Guides ▾
        </a>
        <div class="invisible absolute left-0 top-full z-50 min-w-[260px] pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-md bg-white py-2 shadow-lg">
            <a href={withBase('/guides')} class="block px-4 py-2 text-sm font-medium text-ox-navy hover:bg-ox-cream">
              All Guides
            </a>
            {guideNavItems.map((guide) => (
              <a
                href={withBase(`/guides/${guide.slug}`)}
                class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream"
              >
                {guide.navLabel}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href={withBase('/about')}
        class:list={[
          'text-sm font-medium transition hover:text-ox-gold',
          isActive('/about') ? 'text-ox-gold' : 'text-white',
        ]}
      >
        About
      </a>
      <a
        href={withBase('/faq')}
        class:list={[
          'text-sm font-medium transition hover:text-ox-gold',
          isActive('/faq') ? 'text-ox-gold' : 'text-white',
        ]}
      >
        FAQ
      </a>
      <a
        href={withBase('/contact')}
        class:list={[
          'text-sm font-medium transition hover:text-ox-gold',
          isActive('/contact') ? 'text-ox-gold' : 'text-white',
        ]}
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneTel}`}
        class="hidden rounded-md bg-ox-gold px-4 py-2 text-sm font-semibold text-ox-navy transition hover:bg-ox-gold-dark sm:inline-block"
      >
        {site.phone}
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-white/30 px-3 py-2 text-sm font-medium">
          Menu
        </summary>
        <div class="absolute right-0 mt-2 max-h-[70vh] w-72 overflow-y-auto rounded-md bg-white py-2 shadow-lg">
          <a href={withBase('/services')} class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Services</a>
          <a href={withBase('/service-areas')} class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Service Areas</a>
          <a
            href={withBase('/guides')}
            class="block px-4 pt-2 text-sm font-semibold text-ox-navy hover:bg-ox-cream"
          >
            Guides
          </a>
          {guideNavItems.map((guide) => (
            <a href={withBase(`/guides/${guide.slug}`)} class="block px-4 py-2 pl-6 text-sm text-ox-navy hover:bg-ox-cream">
              {guide.navLabel}
            </a>
          ))}
          <a href={withBase('/about')} class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">About</a>
          <a href={withBase('/faq')} class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">FAQ</a>
          <a href={withBase('/contact')} class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Contact</a>
          <a href={withBase('/contact')} class="block px-4 py-2 text-sm font-semibold text-ox-navy hover:bg-ox-cream">
            Free Estimate
          </a>
          <a href={`tel:${site.phoneTel}`} class="block px-4 py-2 text-sm font-semibold text-ox-gold hover:bg-ox-cream">
            Call {site.phone}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
