---
import { site } from '../data/site';
import { services } from '../data/services';
import { serviceAreas } from '../data/serviceAreas';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-ox-navy text-white shadow-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 no-underline">
      <span class="text-xl font-bold tracking-tight text-white">Blue Ox Tree Care</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
      <div class="group relative">
        <a
          href="/services"
          class:list={[
            'text-sm font-medium transition hover:text-ox-sage',
            isActive('/services') ? 'text-ox-sage' : 'text-white',
          ]}
        >
          Services
        </a>
        <div class="invisible absolute left-0 top-full z-50 min-w-[220px] pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-md bg-white py-2 shadow-lg">
            {services.map((service) => (
              <a
                href={`/services/${service.slug}`}
                class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream"
              >
                {service.shortTitle}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="group relative">
        <a
          href="/service-areas"
          class:list={[
            'text-sm font-medium transition hover:text-ox-sage',
            isActive('/service-areas') ? 'text-ox-sage' : 'text-white',
          ]}
        >
          Service Areas
        </a>
        <div class="invisible absolute left-0 top-full z-50 min-w-[200px] pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-md bg-white py-2 shadow-lg">
            {serviceAreas.map((area) => (
              <a
                href={`/service-areas/${area.slug}`}
                class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream"
              >
                {area.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/about"
        class:list={[
          'text-sm font-medium transition hover:text-ox-sage',
          isActive('/about') ? 'text-ox-sage' : 'text-white',
        ]}
      >
        About
      </a>
      <a
        href="/gallery"
        class:list={[
          'text-sm font-medium transition hover:text-ox-sage',
          isActive('/gallery') ? 'text-ox-sage' : 'text-white',
        ]}
      >
        Gallery
      </a>
      <a
        href="/faq"
        class:list={[
          'text-sm font-medium transition hover:text-ox-sage',
          isActive('/faq') ? 'text-ox-sage' : 'text-white',
        ]}
      >
        FAQ
      </a>
      <a
        href="/contact"
        class:list={[
          'text-sm font-medium transition hover:text-ox-sage',
          isActive('/contact') ? 'text-ox-sage' : 'text-white',
        ]}
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneTel}`}
        class="hidden rounded-md bg-ox-green px-4 py-2 text-sm font-semibold text-white transition hover:bg-ox-green-dark sm:inline-block"
      >
        {site.phone}
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-white/30 px-3 py-2 text-sm font-medium">
          Menu
        </summary>
        <div class="absolute right-0 mt-2 w-64 rounded-md bg-white py-2 shadow-lg">
          <a href="/services" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Services</a>
          <a href="/service-areas" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Service Areas</a>
          <a href="/about" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">About</a>
          <a href="/gallery" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Gallery</a>
          <a href="/faq" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">FAQ</a>
          <a href="/contact" class="block px-4 py-2 text-sm text-ox-navy hover:bg-ox-cream">Contact</a>
          <a href={`tel:${site.phoneTel}`} class="block px-4 py-2 text-sm font-semibold text-ox-green hover:bg-ox-cream">
            Call {site.phone}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
