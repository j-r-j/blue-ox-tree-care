---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  variant?: 'light' | 'dark';
  showBadges?: boolean;
}

const { variant = 'light', showBadges = true } = Astro.props;

const ownerBadges: Record<string, { src: string; alt: string } | undefined> = {
  'travis-berlin': { src: withBase('/badges/bcma-badge.png'), alt: 'ISA Board Certified Master Arborist badge' },
  'lacy-berlin': {
    src: withBase('/badges/isa-certified-arborist.jpg'),
    alt: 'ISA Certified Arborist badge',
  },
};

const isDark = variant === 'dark';
---

<div
  class:list={[
    'border-y',
    isDark ? 'border-white/10 bg-ox-navy/95 text-white' : 'border-ox-navy/10 bg-white text-ox-navy',
  ]}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-2">
      {site.owners.map((owner) => (
        <div class="flex items-center gap-3">
          {showBadges && ownerBadges[owner.id] && (
            <img
              src={ownerBadges[owner.id]!.src}
              alt={ownerBadges[owner.id]!.alt}
              width="36"
              height="52"
              class="h-11 w-auto shrink-0 object-contain"
              loading="lazy"
            />
          )}
          <p class="text-sm">
            <a
              href={withBase(`/arborists/${owner.id}`)}
              class:list={[
                'font-semibold hover:underline',
                isDark ? 'text-white hover:text-ox-gold' : 'text-ox-navy hover:text-ox-blue',
              ]}
            >
              {owner.name}
            </a>
            <span class={isDark ? 'text-white/75' : 'text-ox-navy/70'}> ({owner.credentials})</span>
          </p>
        </div>
      ))}
    </div>
    {site.googleProfile && (
      <a
        href={site.googleProfile}
        class:list={[
          'shrink-0 text-sm font-medium hover:underline',
          isDark ? 'text-ox-gold' : 'text-ox-blue hover:text-ox-blue-dark',
        ]}
        rel="noopener noreferrer"
        target="_blank"
      >
        Read Google reviews →
      </a>
    )}
  </div>
</div>
