---
import type { FAQItem } from '../data/faq';

interface Props {
  heading?: string;
  items: FAQItem[];
}

const { heading = 'Frequently Asked Questions', items } = Astro.props;
---

<section class="py-16 bg-white/50">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="mb-8 text-2xl font-bold text-ox-navy">{heading}</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="group rounded-lg border border-ox-navy/10 bg-white shadow-sm">
          <summary class="cursor-pointer list-none px-6 py-4 font-semibold text-ox-navy marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {item.question}
              <span class="text-ox-green transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <div class="border-t border-ox-navy/10 px-6 py-4 text-ox-navy/80">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
