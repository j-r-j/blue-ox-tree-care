---
import { site, serviceAreaCities } from '../data/site';
import { services } from '../data/services';
import { getGuideNavItems } from '../data/guides';
import { neighborhoods } from '../data/neighborhoods';
import { withBase } from '../lib/paths';
import SocialLinks from './SocialLinks.astro';

const guideNavItems = getGuideNavItems();
---

<footer class="bg-ox-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="mb-3 text-lg font-bold">Blue Ox Tree Care</p>
      <p class="mb-4 text-sm text-white/80">{site.tagline}</p>
      <p class="text-sm">
        <a href={`tel:${site.phoneTel}`} class="font-semibold text-ox-gold hover:underline">
          {site.phone}
        </a>
      </p>
      <div class="mt-4">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-ox-gold">Follow Us</p>
        <SocialLinks variant="footer" />
      </div>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">Services</p>
      <ul class="space-y-2">
        {services.slice(0, 5).map((service) => (
          <li>
            <a href={withBase(`/services/${service.slug}`)} class="text-sm text-white/80 hover:text-white">
              {service.shortTitle}
            </a>
          </li>
        ))}
        <li>
          <a href={withBase('/services')} class="text-sm font-medium text-ox-gold hover:underline">
            View all services →
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">Service Areas</p>
      <ul class="mb-6 space-y-2">
        {serviceAreaCities.map((city) => (
          <li>
            <a href={withBase(`/service-areas/${city.slug}`)} class="text-sm text-white/80 hover:text-white">
              {city.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">Neighborhoods</p>
      <ul class="space-y-2">
        <li><a href={withBase('/neighborhoods')} class="text-sm text-white/80 hover:text-white">All neighborhoods</a></li>
        {neighborhoods.slice(0, 4).map((n) => (
          <li>
            <a href={withBase(`/neighborhoods/${n.slug}`)} class="text-sm text-white/80 hover:text-white">
              {n.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">Guides</p>
      <ul class="mb-6 space-y-2">
        <li><a href={withBase('/guides')} class="text-sm text-white/80 hover:text-white">All Guides</a></li>
        {guideNavItems.map((guide) => (
          <li>
            <a href={withBase(`/guides/${guide.slug}`)} class="text-sm text-white/80 hover:text-white">
              {guide.navLabel}
            </a>
          </li>
        ))}
        <li>
          <a href={withBase('/journal')} class="text-sm text-white/80 hover:text-white">Journal</a>
        </li>
      </ul>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">Company</p>
      <ul class="space-y-2">
        <li><a href={withBase('/about')} class="text-sm text-white/80 hover:text-white">About Us</a></li>
        <li><a href={withBase('/arborists')} class="text-sm text-white/80 hover:text-white">Our Arborists</a></li>
        <li><a href={withBase('/what-to-expect')} class="text-sm text-white/80 hover:text-white">What to Expect</a></li>
        <li><a href={withBase('/gallery')} class="text-sm text-white/80 hover:text-white">Gallery</a></li>
        <li><a href={withBase('/faq')} class="text-sm text-white/80 hover:text-white">FAQ</a></li>
        <li><a href={withBase('/contact')} class="text-sm text-white/80 hover:text-white">Contact</a></li>
      </ul>
      <p class="mt-4 text-xs text-white/60">
        Service-area business — no public storefront. We come to your property.
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-4 text-xs text-white/60 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <p>ISA Certified Arborists · Austin, Texas</p>
    </div>
  </div>
</footer>
