---
import { site, serviceAreaCities } from '../data/site';
import { services } from '../data/services';
import { getGuideNavItems } from '../data/guides';
import { neighborhoods } from '../data/neighborhoods';
import { estimateFormPath } from '../data/leadForm';
import { withBase } from '../lib/paths';
import SocialLinks from './SocialLinks.astro';

const featuredService = services.find((s) => s.slug === 'pest-disease');
const footerServices = [
  ...(featuredService ? [featuredService] : []),
  ...services.filter((s) => s.slug !== 'pest-disease'),
];

const linkGroups: { heading: string; links: { label: string; href: string; hub?: boolean }[] }[] = [
  {
    heading: 'Services',
    links: [
      ...footerServices.map((s) => ({ label: s.shortTitle, href: `/services/${s.slug}` })),
      { label: 'All services', href: '/services', hub: true },
    ],
  },
  {
    heading: 'Areas We Serve',
    links: [
      ...serviceAreaCities.map((c) => ({ label: c.name, href: `/service-areas/${c.slug}` })),
      { label: `Austin neighborhoods (${neighborhoods.length})`, href: '/neighborhoods' },
      { label: 'All service areas', href: '/service-areas', hub: true },
    ],
  },
  {
    heading: 'Resources',
    links: [
      ...getGuideNavItems().map((g) => ({ label: `${g.navLabel} guide`, href: `/guides/${g.slug}` })),
      { label: 'Tree care journal', href: '/journal' },
      { label: 'FAQ', href: '/faq' },
      { label: 'All resources', href: '/guides', hub: true },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About us', href: '/about' },
      { label: 'Our arborists', href: '/arborists' },
      { label: 'What to expect', href: '/what-to-expect' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
---

<footer class="bg-ox-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[1.2fr_3fr] lg:gap-12">
    <div>
      <p class="mb-2 text-lg font-bold">{site.name}</p>
      <p class="mb-4 max-w-xs text-sm text-white/75">{site.tagline}</p>
      <a href={`tel:${site.phoneTel}`} class="block text-xl font-bold text-ox-gold hover:underline">
        {site.phone}
      </a>
      <p class="mb-4 text-sm text-white/75">{site.hours.short}</p>
      <a href={withBase(estimateFormPath)} class="btn-primary mb-6 inline-block px-5 py-2.5 text-sm">
        Get a Free Estimate
      </a>
      <SocialLinks variant="footer" />
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
      {linkGroups.map((group) => (
        <nav aria-label={`Footer: ${group.heading}`}>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-ox-gold">{group.heading}</p>
          <ul class="space-y-1">
            {group.links.map((link) => (
              <li>
                <a
                  href={withBase(link.href)}
                  class:list={[
                    'inline-block py-1 text-sm hover:text-white hover:underline',
                    link.hub ? 'font-semibold text-ox-gold' : 'text-white/80',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 text-xs text-white/60 md:flex-row md:items-center md:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.legalName}. ISA Certified Arborists, Austin, Texas.</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p>{site.serviceAreaNote}</p>
        {legalLinks.map((link) => (
          <a href={withBase(link.href)} class="hover:text-white hover:underline">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
