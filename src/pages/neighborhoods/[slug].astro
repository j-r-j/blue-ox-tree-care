---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import SidebarCTA from '../../components/SidebarCTA.astro';
import { neighborhoods, getNeighborhood } from '../../data/neighborhoods';
import { services } from '../../data/services';
import { guides } from '../../data/guides';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return neighborhoods.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const neighborhood = getNeighborhood(slug!);

if (!neighborhood) {
  return Astro.redirect('/neighborhoods');
}

const relatedServices = services.filter((s) => neighborhood.relatedServices.includes(s.slug));
const relatedGuides = guides.filter((g) => neighborhood.relatedGuides.includes(g.slug));
const nearby = neighborhoods.filter((n) => n.region === neighborhood.region && n.slug !== neighborhood.slug);

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas We Serve', path: '/service-areas' },
  { name: 'Austin Neighborhoods', path: '/neighborhoods' },
  { name: neighborhood.name, path: `/neighborhoods/${neighborhood.slug}` },
];
---

<BaseLayout
  title={neighborhood.title}
  description={neighborhood.metaDescription}
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    ctas
    title={neighborhood.title}
    description={neighborhood.heroSubtitle}
    breadcrumbs={breadcrumbs}
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          {neighborhood.sections.map((section) => (
            <div class="mb-10">
              <h2 class="mb-4 text-2xl font-bold text-ox-navy">{section.heading}</h2>
              <div class="space-y-4 text-ox-navy/90">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              {section.list && (
                <ul class="mt-4 space-y-2">
                  {section.list.map((item) => (
                    <li class="flex items-start gap-2 text-ox-navy/90">
                      <span class="check-mark mt-1">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

        <aside class="space-y-6">
          <SidebarCTA heading={`Free estimate in ${neighborhood.name.split(' / ')[0]}`} />
          <div class="sidebar-card">
            <h2 class="sidebar-heading">Popular services</h2>
            <ul class="space-y-2">
              {relatedServices.map((service) => (
                <li>
                  <a href={withBase(`/services/${service.slug}`)} class="link-aside">
                    {service.shortTitle}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="sidebar-card">
            <h2 class="sidebar-heading">Local guides</h2>
            <ul class="space-y-2">
              {relatedGuides.map((guide) => (
                <li>
                  <a href={withBase(`/guides/${guide.slug}`)} class="link-aside">
                    {guide.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {nearby.length > 0 && (
            <div class="sidebar-card">
              <h2 class="sidebar-heading">Nearby neighborhoods</h2>
              <ul class="space-y-2">
                {nearby.map((n) => (
                  <li>
                    <a href={withBase(`/neighborhoods/${n.slug}`)} class="link-aside">
                      Tree care in {n.name}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="mt-4 border-t border-ox-navy/10 pt-3 text-sm">
                <a href={withBase('/service-areas/austin')} class="link-aside font-medium">Tree care in Austin →</a>
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <CTABanner heading={`Tree care in ${neighborhood.name}`} />
</BaseLayout>
