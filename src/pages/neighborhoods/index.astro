---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { neighborhoodRegions, getNeighborhoodsByRegion } from '../../data/neighborhoods';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas We Serve', path: '/service-areas' },
  { name: 'Austin Neighborhoods', path: '/neighborhoods' },
];
---

<BaseLayout
  title="Austin Neighborhood Tree Care Guides"
  description="Arborist tree care in 16 Austin neighborhoods: Tarrytown, Hyde Park, West Lake Hills, Barton Creek, Circle C, and more. Call (512) 749-8615."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    ctas
    title="Austin Neighborhood Tree Care"
    description="Local tree care for Austin neighborhoods: live oaks, heritage trees, Hill Country land, and city tree rules."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <p class="mb-10 text-ox-navy/85">
        Blue Ox Tree Care works most in central and west Austin. In these neighborhoods, big old trees
        give each street its look. Each page below has its own tips on live oaks, protected tree rules,
        when to prune for oak wilt, storm help, and care for your kind of lot. We have no storefront.
        Call (512) 749-8615 and we will come to you.
      </p>

      {neighborhoodRegions.map((region) => {
        const items = getNeighborhoodsByRegion(region.id);
        return (
          <div class="mb-12">
            <h2 class="mb-6 border-b border-ox-navy/10 pb-2 text-2xl font-bold text-ox-navy">
              {region.label}
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
              {items.map((n) => (
                <article class="group relative flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:border-ox-gold hover:shadow-md">
                  <h3 class="mb-1 text-lg font-bold text-ox-navy">
                    <a
                      href={withBase(`/neighborhoods/${n.slug}`)}
                      class="after:absolute after:inset-0 after:rounded-lg group-hover:text-ox-blue-dark"
                    >
                      Tree care in {n.name}
                    </a>
                  </h3>
                  <p class="mb-3 text-xs font-medium text-ox-navy/60">ZIP {n.zipCodes.join(', ')}</p>
                  <p class="mb-4 flex-1 text-sm text-ox-navy/80">{n.heroSubtitle}</p>
                  <span class="text-sm font-semibold text-ox-blue-dark group-hover:underline" aria-hidden="true">
                    View neighborhood →
                  </span>
                </article>
              ))}
            </div>
          </div>
        );
      })}

      <p class="text-sm text-ox-navy/70">
        Live somewhere else? See{' '}
        <a href={withBase('/service-areas/austin')} class="link-body">tree care in Austin</a>,{' '}
        <a href={withBase('/service-areas/round-rock')} class="link-body">Round Rock</a>, and{' '}
        <a href={withBase('/service-areas/bee-cave-lakeway')} class="link-body">Bee Cave &amp; Lakeway</a>.
      </p>
    </div>
  </section>

  <CTABanner heading="Tree care in your neighborhood" />
</BaseLayout>
