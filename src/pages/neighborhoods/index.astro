---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { neighborhoodRegions, getNeighborhoodsByRegion } from '../../data/neighborhoods';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Neighborhoods', path: '/neighborhoods' },
];
---

<BaseLayout
  title="Austin Neighborhood Tree Care | ISA Certified Arborists"
  description="Tree care by neighborhood — central and west Austin live oak canopy, West Lake Hills, Barton Creek, Circle C, Steiner Ranch, and more. Blue Ox Tree Care. Call (512) 749-8615."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    title="Austin Neighborhood Tree Care"
    description="Local arboriculture for Central Texas communities — live oaks, heritage trees, Hill Country terrain, and city regulations."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <p class="mb-12 text-ox-navy/85">
        Blue Ox Tree Care focuses on central and west Austin neighborhoods where mature canopy defines
        the character of each community. Every page below has unique guidance on live oaks, heritage
        and protected tree rules, oak wilt timing, storm response, and lot-specific tree care. We are a
        service-area business — call (512) 749-8615 and we come to your property.
      </p>

      {neighborhoodRegions.map((region) => {
        const items = getNeighborhoodsByRegion(region.id);
        return (
          <div class="mb-14">
            <h2 class="mb-6 border-b border-ox-navy/10 pb-2 text-2xl font-bold text-ox-navy">
              {region.label}
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
              {items.map((n) => (
                <article class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
                  <h3 class="mb-2 text-lg font-bold text-ox-navy">
                    <a href={withBase(`/neighborhoods/${n.slug}`)} class="hover:text-ox-blue">
                      {n.name}
                    </a>
                  </h3>
                  <p class="mb-1 text-xs text-ox-navy/60">ZIP: {n.zipCodes.join(', ')}</p>
                  <p class="mb-4 text-sm text-ox-navy/80">{n.heroSubtitle}</p>
                  <a href={withBase(`/neighborhoods/${n.slug}`)} class="link-aside font-medium">
                    Tree care in {n.name.split(' / ')[0]} →
                  </a>
                </article>
              ))}
            </div>
          </div>
        );
      })}

      <p class="text-sm text-ox-navy/70">
        Also see our{' '}
        <a href={withBase('/service-areas/austin')} class="link-body">Austin service area</a> page
        for broader Travis County coverage including Round Rock, Bee Cave, and Lakeway.
      </p>
    </div>
  </section>

  <CTABanner heading="Tree care in your neighborhood" />
</BaseLayout>
