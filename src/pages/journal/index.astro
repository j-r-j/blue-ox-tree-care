---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { journalPosts } from '../../data/journal';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/journal' },
];
---

<BaseLayout
  title="Tree Care Journal | Austin & Central Texas"
  description="Articles on live oak pruning, storm triage, Austin brush pickup, and hiring ISA arborists, from Blue Ox Tree Care in Austin, TX. Call (512) 749-8615."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    title="Tree Care Journal"
    description="Long-form articles for Austin-area homeowners, written by ISA certified arborists."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-6">
        {journalPosts.map((post) => (
          <article class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <time datetime={post.datePublished} class="text-xs font-semibold uppercase tracking-wide text-ox-gold">
              {new Date(post.datePublished).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="mb-2 mt-2 text-xl font-bold text-ox-navy">
              <a href={withBase(`/journal/${post.slug}`)} class="hover:text-ox-blue">
                {post.title}
              </a>
            </h2>
            <p class="mb-4 text-sm text-ox-navy/80">{post.heroSubtitle}</p>
            <a href={withBase(`/journal/${post.slug}`)} class="link-aside font-medium">
              Read article →
            </a>
          </article>
        ))}
      </div>
      <p class="mt-10 text-sm text-ox-navy/70">
        For in-depth guides, see our{' '}
        <a href={withBase('/guides')} class="link-body">Austin tree care guides</a>. New to Blue Ox? Read{' '}
        <a href={withBase('/what-to-expect')} class="link-body">what to expect</a> when you hire us.
      </p>
    </div>
  </section>

  <CTABanner heading="Questions about your trees?" />
</BaseLayout>
