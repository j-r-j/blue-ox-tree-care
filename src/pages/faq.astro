---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageBanner from '../components/PageBanner.astro';
import { faqItems } from '../data/faq';
import { breadcrumbSchema, combineSchemas, faqPageSchema } from '../lib/schema';
---

<BaseLayout
  title="Tree Care FAQ | Austin, TX"
  description="Frequently asked questions about tree care in Austin, TX. Oak wilt, pruning seasons, permits, organic treatments, and scheduling with Blue Ox Tree Care."
  schema={combineSchemas(
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'FAQ', path: '/faq' },
    ]),
    faqPageSchema(faqItems),
  )}
>
  <PageBanner
    title="Frequently Asked Questions"
    description="Common questions about tree care in the Austin area — answered by ISA certified arborists."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'FAQ', path: '/faq' },
    ]}
  />

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4">
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group rounded-lg border border-ox-navy/10 bg-white shadow-sm">
            <summary class="cursor-pointer list-none px-6 py-4 font-semibold text-ox-navy marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {item.question}
                <span class="text-ox-gold transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <div class="border-t border-ox-navy/10 px-6 py-4 text-ox-navy/80">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
