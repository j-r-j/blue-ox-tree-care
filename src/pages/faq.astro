---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { faqItems } from '../data/faq';
import { faqPageSchema } from '../lib/schema';
---

<BaseLayout
  title="Tree Care FAQ | Austin, TX"
  description="Frequently asked questions about tree care in Austin, TX. Oak wilt, pruning seasons, permits, and scheduling with Blue Ox Tree Care."
  schema={faqPageSchema(faqItems)}
>
  <section class="bg-ox-green-dark py-12 text-white">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="mb-4 text-4xl font-bold">Frequently Asked Questions</h1>
      <p class="text-lg text-white/90">
        Common questions about tree care in the Austin area.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4">
      <dl class="space-y-6">
        {faqItems.map((item) => (
          <div class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <dt class="mb-2 text-lg font-semibold text-ox-navy">{item.question}</dt>
            <dd class="text-ox-navy/80">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
