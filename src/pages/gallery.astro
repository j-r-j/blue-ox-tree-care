---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
---

<BaseLayout
  title="Tree Care Gallery | Austin, TX Projects"
  description="View Blue Ox Tree Care project photos from Austin, Round Rock & Bee Cave. Tree trimming, removal, and arborist work."
>
  <section class="bg-ox-green-dark py-12 text-white">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="mb-4 text-4xl font-bold">Project Gallery</h1>
      <p class="text-lg text-white/90">
        A selection of tree care projects across the Austin metro. Photos coming soon.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class="flex aspect-[4/3] items-center justify-center rounded-lg bg-ox-green/20">
            <span class="text-sm font-medium text-ox-navy/50">Project photo {i + 1}</span>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ox-navy/60">
        Placeholder images — real project photos will be added before launch.
      </p>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
