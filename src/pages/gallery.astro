---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageBanner from '../components/PageBanner.astro';
import { breadcrumbSchema } from '../lib/schema';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Tree Care Gallery | Austin, TX Projects"
  description="View Blue Ox Tree Care project photos from Austin, Round Rock & Bee Cave. Tree trimming, removal, and arborist work."
  schema={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Gallery', path: '/gallery' },
  ])}
>
  <PageBanner
    title="Project Gallery"
    description="Photos from tree care projects across the Austin metro."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Gallery', path: '/gallery' },
    ]}
  />

  <section class="bg-ox-navy py-20">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border-2 border-ox-gold/40 bg-white/5">
        <svg class="h-7 w-7 text-ox-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h2 class="mb-4 text-2xl font-bold text-white">Project photos coming soon</h2>
      <p class="mb-8 text-white/80">
        We are preparing a gallery of recent trimming, removal, and arborist work from Austin, Round Rock,
        and Bee Cave / Lakeway. Check back soon, or call for a free estimate in the meantime.
      </p>
      <a href={withBase('/contact')} class="btn-primary inline-block px-6 py-3">
        Request a Free Estimate
      </a>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
