---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import AreaCard from '../../components/AreaCard.astro';
import NeighborhoodLinks from '../../components/NeighborhoodLinks.astro';
import { site } from '../../data/site';
import { serviceAreas } from '../../data/serviceAreas';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas We Serve', path: '/service-areas' },
];
---

<BaseLayout
  title="Areas We Serve | Austin Metro Tree Care"
  description="Tree care in Austin, Round Rock, Bee Cave, Lakeway and 16 Austin neighborhoods. ISA certified arborists come to your property. Call (512) 749-8615."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    ctas
    title="Areas We Serve"
    description="ISA certified tree care across the greater Austin metro and Central Texas Hill Country."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-6 text-2xl font-bold text-ox-navy">Cities</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {serviceAreas.map((area) => (
          <AreaCard area={area} />
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-ox-navy/10 bg-white py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-bold text-ox-navy">Austin neighborhoods</h2>
        <a href={withBase('/neighborhoods')} class="link-aside font-semibold">
          Neighborhood guide overview →
        </a>
      </div>
      <NeighborhoodLinks />
      <p class="mt-8 text-sm text-ox-navy/75">
        Don't see your area listed? Call <a href={`tel:${site.phoneTel}`} class="link-body">{site.phone}</a>.
        We may still be able to help.
      </p>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
