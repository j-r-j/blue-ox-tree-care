---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import AreaCard from '../../components/AreaCard.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { breadcrumbSchema } from '../../lib/schema';
---

<BaseLayout
  title="Tree Care Service Areas | Austin Metro"
  description="Tree care in Austin, Round Rock, Bee Cave & Lakeway, TX. Trimming, removal, risk assessment, and organic treatments by ISA certified arborists. Call (512) 749-8615."
  schema={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Service Areas', path: '/service-areas' },
  ])}
>
  <PageBanner
    title="Service Areas"
    description="Proudly serving the greater Austin metro and Central Texas Hill Country."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Service Areas', path: '/service-areas' },
    ]}
  />

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-6 md:grid-cols-3">
        {serviceAreas.map((area) => (
          <AreaCard area={area} />
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ox-navy/70">
        Don't see your area listed? Call us. We may still be able to help.
      </p>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
