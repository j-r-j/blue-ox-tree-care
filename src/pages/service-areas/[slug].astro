---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { serviceAreas, getServiceArea } from '../../data/serviceAreas';
import { services } from '../../data/services';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = getServiceArea(slug!);

if (!area) {
  return Astro.redirect('/service-areas');
}

const relatedServices = services.filter((s) => area.relatedServices.includes(s.slug));
---

<BaseLayout
  title={area.title}
  description={area.metaDescription}
>
  <section class="bg-ox-green-dark py-12 text-white">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="mb-4 text-4xl font-bold">{area.title}</h1>
      <p class="text-lg text-white/90">{area.description}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          <h2 class="mb-4 text-2xl font-bold text-ox-navy">Neighborhoods & Communities</h2>
          <ul class="mb-8 grid gap-2 sm:grid-cols-2">
            {area.neighborhoods.map((n) => (
              <li class="flex items-center gap-2 text-ox-navy/90">
                <span class="text-ox-green">•</span>
                {n}
              </li>
            ))}
          </ul>

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">Popular Services in {area.name}</h2>
          <ul class="space-y-3">
            {relatedServices.map((service) => (
              <li>
                <a
                  href={`/services/${service.slug}`}
                  class="font-medium text-ox-green hover:underline"
                >
                  {service.shortTitle}
                </a>
                <p class="text-sm text-ox-navy/70">{service.description.slice(0, 100)}…</p>
              </li>
            ))}
          </ul>
        </div>

        <aside>
          <div class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <h3 class="mb-3 font-semibold text-ox-navy">Other Service Areas</h3>
            <ul class="space-y-2">
              {serviceAreas
                .filter((a) => a.slug !== area.slug)
                .map((a) => (
                  <li>
                    <a href={`/service-areas/${a.slug}`} class="text-sm text-ox-green hover:underline">
                      {a.name}
                    </a>
                  </li>
                ))}
            </ul>
            <div class="mt-6 border-t border-ox-navy/10 pt-4">
              <a href="/services" class="text-sm font-medium text-ox-green hover:underline">
                View all services →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner heading={`Tree care in ${area.name}`} />
</BaseLayout>
