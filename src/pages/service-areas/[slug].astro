---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { serviceAreas, getServiceArea } from '../../data/serviceAreas';
import { neighborhoods } from '../../data/neighborhoods';
import { services } from '../../data/services';
import { breadcrumbSchema, combineSchemas } from '../../lib/schema';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = getServiceArea(slug!);

if (!area) {
  return Astro.redirect('/service-areas');
}

const relatedServices = services.filter((s) => area.relatedServices.includes(s.slug));

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas' },
  { name: area.name, path: `/service-areas/${area.slug}` },
]);
---

<BaseLayout
  title={area.title}
  description={area.metaDescription}
  schema={schema}
>
  <PageBanner title={area.title} description={area.description} breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Service Areas', path: '/service-areas' },
    { name: area.name, path: `/service-areas/${area.slug}` },
  ]} />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          <div class="mb-8 space-y-4 text-ox-navy/90">
            {area.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">Neighborhoods & Communities</h2>
          <ul class="mb-8 grid gap-2 sm:grid-cols-2">
            {area.neighborhoods.map((n) => (
              <li class="flex items-center gap-2 text-ox-navy/90">
                <span class="list-bullet">•</span>
                {n}
              </li>
            ))}
          </ul>

          {area.slug === 'austin' && (
            <div class="mb-8">
              <h2 class="mb-4 text-2xl font-bold text-ox-navy">Featured Austin Neighborhoods</h2>
              <p class="mb-4 text-sm text-ox-navy/80">
                Detailed tree care information for communities we serve frequently across Austin:
              </p>
              <ul class="grid gap-2 sm:grid-cols-2">
                {neighborhoods.map((n) => (
                  <li>
                    <a href={withBase(`/neighborhoods/${n.slug}`)} class="link-body">
                      {n.name}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm">
                <a href={withBase('/neighborhoods')} class="link-aside font-medium">View all neighborhoods →</a>
              </p>
            </div>
          )}

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">Popular Services in {area.name}</h2>
          <ul class="space-y-3">
            {relatedServices.map((service) => (
              <li>
                <a
                  href={withBase(`/services/${service.slug}`)}
                  class="link-body"
                >
                  {service.shortTitle}
                </a>
                <p class="text-sm text-ox-navy/70">{service.intro}</p>
              </li>
            ))}
          </ul>
        </div>

        <aside>
          <div class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <h3 class="mb-3 font-semibold text-ox-navy">Other Service Areas</h3>
            <ul class="space-y-2">
              {serviceAreas
                .filter((a) => a.slug !== area.slug)
                .map((a) => (
                  <li>
                    <a href={withBase(`/service-areas/${a.slug}`)} class="link-aside">
                      {a.name}
                    </a>
                  </li>
                ))}
            </ul>
            <div class="mt-6 border-t border-ox-navy/10 pt-4">
              <a href={withBase('/services')} class="link-aside font-medium">
                View all services →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner heading={`Tree care in ${area.name}`} />
</BaseLayout>
