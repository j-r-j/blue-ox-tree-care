---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import CredentialStrip from '../components/CredentialStrip.astro';
import GoogleReviewsStrip from '../components/GoogleReviewsStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AreaCard from '../components/AreaCard.astro';
import { site, seo } from '../data/site';
import { services } from '../data/services';
import { serviceAreas } from '../data/serviceAreas';
import { getGuideNavItems } from '../data/guides';
import { localBusinessSchema } from '../lib/schema';
import { withBase } from '../lib/paths';

const guideNavItems = getGuideNavItems();
---

<BaseLayout
  title={seo.home.title}
  description={seo.home.description}
  schema={localBusinessSchema()}
>
  <section class="overflow-hidden bg-gradient-to-b from-ox-navy to-[#152f3c] text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-ox-gold">Austin, Texas</p>
        <h1 class="mb-4 text-4xl font-bold leading-tight md:text-5xl">
          Professional Tree Care in Austin by ISA Certified Arborists
        </h1>
        <p class="mb-4 text-lg text-white/90">
          An ISA certified arborist team led by Board Certified Master Arborist Travis Berlin — with
          Lacy Berlin, an ISA Certified Arborist — serving Austin, Round Rock, Bee Cave, and Lakeway
          from structural pruning to organic pest and disease care.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-white/85">
          {site.trustLines.map((line) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-ox-gold">✓</span>
              {line}
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href={`tel:${site.phoneTel}`}
            class="rounded-md bg-ox-gold px-6 py-3 text-center font-semibold text-ox-navy transition hover:bg-ox-gold-dark"
          >
            Call {site.phone}
          </a>
          <a
            href={withBase('/contact')}
            class="rounded-md border-2 border-white px-6 py-3 text-center font-semibold text-white transition hover:bg-white/10"
          >
            Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CredentialStrip variant="dark" />

  <GoogleReviewsStrip />

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 text-center">
        <h2 class="mb-3 text-3xl font-bold text-ox-navy">Tree Care Services in Central Texas</h2>
        <p class="mx-auto max-w-2xl text-ox-navy/80">
          From routine pruning to emergency storm response, we provide full-service arboriculture
          tailored to Austin-area trees and regulations.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href={withBase('/services')} class="font-semibold text-ox-blue hover:text-ox-blue-dark hover:underline">
          View all services →
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 text-center">
        <h2 class="mb-3 text-3xl font-bold text-ox-navy">Areas We Serve</h2>
        <p class="mx-auto max-w-2xl text-ox-navy/80">
          Proudly serving homeowners and property managers across the Austin metro.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {serviceAreas.map((area) => (
          <AreaCard area={area} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 text-center">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-ox-gold">Local knowledge</p>
        <h2 class="mb-3 text-3xl font-bold text-ox-navy">Austin tree guides</h2>
        <p class="mx-auto max-w-2xl text-ox-navy/80">
          Practical guides for Austin-area homeowners — written by ISA certified arborists.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {guideNavItems.map((guide, index) => (
          <article
            class:list={[
              'rounded-lg border bg-white p-6 shadow-sm',
              index === 0 ? 'border-ox-gold ring-1 ring-ox-gold/30' : 'border-ox-navy/10',
            ]}
          >
            {index === 0 && (
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-ox-gold">Featured</p>
            )}
            <h3 class="mb-3 text-lg font-bold text-ox-navy">
              <a href={withBase(`/guides/${guide.slug}`)} class="hover:text-ox-blue">
                {guide.title}
              </a>
            </h3>
            <p class="mb-4 text-sm text-ox-navy/80">{guide.heroSubtitle}</p>
            <a href={withBase(`/guides/${guide.slug}`)} class="link-aside font-medium">
              Read guide →
            </a>
          </article>
        ))}
      </div>
      <div class="mt-8 text-center text-sm text-ox-navy/70">
        <a href={withBase('/journal')} class="link-body font-medium">Tree care journal →</a>
        <span class="mx-2">·</span>
        <a href={withBase('/what-to-expect')} class="link-body font-medium">What to expect →</a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="mb-4 text-3xl font-bold text-ox-navy">Why Choose Blue Ox?</h2>
      <div class="grid gap-8 text-left md:grid-cols-3">
        <div>
          <h3 class="mb-2 font-semibold text-ox-blue">ISA Certified</h3>
          <p class="text-sm text-ox-navy/80">
            <a href={withBase('/arborists/travis-berlin')} class="link-body">Travis Berlin</a> is an ISA Board Certified Master Arborist (RM-7612B) — a credential earned by fewer than 2% of ISA Certified Arborists.{' '}
            <a href={withBase('/arborists/lacy-berlin')} class="link-body">Lacy Berlin</a> is an ISA Certified Arborist (RM-8632A).
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold text-ox-blue">Licensed & Insured</h3>
          <p class="text-sm text-ox-navy/80">
            Professional equipment, rigorous safety standards, and full insurance for hazardous tree work on your property.
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold text-ox-blue">Central Texas Expertise</h3>
          <p class="text-sm text-ox-navy/80">
            Live oaks, oak wilt protocols, heritage tree permits, organic treatments, and Hill Country fire mitigation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner subtext="Free estimates — call or contact us for tree care anywhere in the Austin metro." />
</BaseLayout>
