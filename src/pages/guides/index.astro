---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { guides } from '../../data/guides';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Tree Care Guides for Austin & Central Texas"
  description="Educational guides on ARR bulk and brush pickup for tree debris, oak wilt, City of Austin protected and heritage tree rules, and storm damage response — from ISA certified arborists at Blue Ox Tree Care."
  schema={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides' },
  ])}
>
  <PageBanner
    title="Tree Care Guides"
    description="Practical, accurate information for Austin-area homeowners — written by ISA certified arborists."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Guides', path: '/guides' },
    ]}
  />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-6 md:grid-cols-2">
        {guides.map((guide) => (
          <article class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <h2 class="mb-3 text-xl font-bold text-ox-navy">
              <a href={withBase(`/guides/${guide.slug}`)} class="hover:text-ox-blue">
                {guide.title}
              </a>
            </h2>
            <p class="mb-4 text-sm text-ox-navy/80">{guide.heroSubtitle}</p>
            <a
              href={withBase(`/guides/${guide.slug}`)}
              class="link-aside font-medium"
            >
              Read guide →
            </a>
          </article>
        ))}
        <article class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
          <h2 class="mb-3 text-xl font-bold text-ox-navy">
            <a href={withBase('/services/storm-damage')} class="hover:text-ox-blue">
              Emergency Storm Damage Response
            </a>
          </h2>
          <p class="mb-4 text-sm text-ox-navy/80">
            After Central Texas storms — hazardous limbs, fallen trees, and when to call for emergency tree service.
          </p>
          <a
            href={withBase('/services/storm-damage')}
            class="link-aside font-medium"
          >
            Storm damage service →
          </a>
        </article>
      </div>
      <p class="mt-8 text-center text-sm text-ox-navy/70">
        <a href={withBase('/journal')} class="link-body font-medium">Tree care journal →</a>
      </p>
    </div>
  </section>

  <CTABanner heading="Questions about your trees?" subtext="Call for an ISA certified assessment anywhere in our Austin metro service area." />
</BaseLayout>
