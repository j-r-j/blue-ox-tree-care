---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { guides, guideNavSlugs } from '../../data/guides';
import { journalPosts } from '../../data/journal';
import { breadcrumbSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/guides' },
];

const navOrder = (slug: string) => {
  const index = (guideNavSlugs as readonly string[]).indexOf(slug);
  return index === -1 ? guideNavSlugs.length : index;
};
const guideItems = [...guides].sort((a, b) => navOrder(a.slug) - navOrder(b.slug));

const helpLinks = [
  {
    label: 'Tree care FAQ',
    href: '/faq',
    text: 'Pruning seasons, permits, oak wilt, organic treatments, and scheduling.',
  },
  {
    label: 'What to expect',
    href: '/what-to-expect',
    text: 'How estimates, scheduling, payment, and storm triage work with Blue Ox.',
  },
  {
    label: 'Emergency storm damage',
    href: '/services/storm-damage',
    text: 'Hazardous limbs or a tree on your roof? What to do and when to call.',
  },
];
---

<BaseLayout
  title="Austin Tree Care Guides & Resources"
  description="Austin tree care guides from ISA certified arborists: brush pickup, oak wilt, protected tree permits, FAQ, and articles. Call (512) 749-8615."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner
    title="Tree Care Guides & Resources"
    description="Practical, accurate information for Austin-area homeowners, written by ISA certified arborists."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-6 text-2xl font-bold text-ox-navy">Austin guides</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {guideItems.map((guide) => (
          <article class="group relative flex flex-col rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm transition hover:border-ox-gold hover:shadow-md">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-ox-navy/60">Guide</p>
            <h3 class="mb-3 text-lg font-bold text-ox-navy">
              <a
                href={withBase(`/guides/${guide.slug}`)}
                class="after:absolute after:inset-0 after:rounded-lg group-hover:text-ox-blue-dark"
              >
                {guide.title}
              </a>
            </h3>
            <p class="mb-4 flex-1 text-sm text-ox-navy/80">{guide.heroSubtitle}</p>
            <span class="text-sm font-semibold text-ox-blue-dark group-hover:underline" aria-hidden="true">
              Read guide →
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-ox-navy/10 bg-white py-12 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[3fr_2fr]">
      <div>
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-bold text-ox-navy">From the journal</h2>
          <a href={withBase('/journal')} class="link-aside shrink-0 font-semibold">All articles →</a>
        </div>
        <ul class="divide-y divide-ox-navy/10">
          {journalPosts.map((post) => (
            <li class="py-4 first:pt-0">
              <h3 class="mb-1 font-semibold text-ox-navy">
                <a href={withBase(`/journal/${post.slug}`)} class="hover:text-ox-blue-dark hover:underline">
                  {post.title}
                </a>
              </h3>
              <p class="text-sm text-ox-navy/75">{post.heroSubtitle}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="mb-6 text-2xl font-bold text-ox-navy">Before you hire</h2>
        <ul class="space-y-4">
          {helpLinks.map((link) => (
            <li class="rounded-lg border border-ox-navy/10 bg-ox-cream p-5">
              <h3 class="mb-1 font-semibold text-ox-navy">
                <a href={withBase(link.href)} class="hover:text-ox-blue-dark hover:underline">
                  {link.label}
                </a>
              </h3>
              <p class="text-sm text-ox-navy/75">{link.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CTABanner heading="Questions about your trees?" subtext="Call for an ISA certified assessment anywhere in our Austin metro service area." />
</BaseLayout>
