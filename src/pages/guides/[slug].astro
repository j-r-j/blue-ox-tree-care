---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import FAQSection from '../../components/FAQSection.astro';
import PageBanner from '../../components/PageBanner.astro';
import SidebarCTA from '../../components/SidebarCTA.astro';
import { guides, getGuide } from '../../data/guides';
import { breadcrumbSchema, combineSchemas, faqPageSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
  }));
}

const { slug } = Astro.params;
const guide = getGuide(slug!);

if (!guide) {
  return Astro.redirect('/guides');
}

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/guides' },
  { name: guide.navLabel ?? guide.title, path: `/guides/${guide.slug}` },
];

const schema = combineSchemas(
  breadcrumbSchema(breadcrumbs),
  faqPageSchema(guide.faqs),
);
---

<BaseLayout title={guide.title} description={guide.metaDescription} schema={schema}>
  <PageBanner title={guide.title} description={guide.heroSubtitle} breadcrumbs={breadcrumbs} />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          {guide.sections.map((section) => (
            <div class="mb-10">
              <h2 class="mb-4 text-2xl font-bold text-ox-navy">{section.heading}</h2>
              <div class="space-y-4 text-ox-navy/90">
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              {section.list && (
                <ul class="mt-4 space-y-2">
                  {section.list.map((item) => (
                    <li class="flex items-start gap-2 text-ox-navy/90">
                      <span class="check-mark mt-1">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}

          {guide.callout && (
            <div class="callout-panel">
              <h2 class="mb-2 text-lg font-bold text-ox-navy">{guide.callout.heading}</h2>
              <p class="text-sm text-ox-navy/80">{guide.callout.body}</p>
              {guide.callout.links && guide.callout.links.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {guide.callout.links.map((link) => (
                    <li>
                      <a
                        href={link.external ? link.href : withBase(link.href)}
                        class="link-aside font-medium"
                        rel={link.external ? 'noopener noreferrer' : undefined}
                        target={link.external ? '_blank' : undefined}
                      >
                        {link.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>

        <aside class="space-y-6">
          <SidebarCTA heading="Want an arborist's opinion?" />
          <div class="sidebar-card">
            <h2 class="sidebar-heading">Related pages</h2>
            <ul class="space-y-2">
              {guide.relatedLinks.map((link) => (
                <li>
                  <a href={withBase(link.href)} class="link-aside">
                    {link.label}
                  </a>
                </li>
              ))}
              <li class="border-t border-ox-navy/10 pt-3">
                <a href={withBase('/guides')} class="link-aside font-semibold">
                  All guides &amp; resources →
                </a>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <FAQSection items={guide.faqs} />

  <CTABanner
    heading="Schedule a tree assessment"
    subtext="ISA certified arborists serving Austin, Round Rock, Bee Cave, and Lakeway."
  />
</BaseLayout>
