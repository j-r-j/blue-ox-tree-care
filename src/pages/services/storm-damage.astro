---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import FAQSection from '../../components/FAQSection.astro';
import PageBanner from '../../components/PageBanner.astro';
import { site } from '../../data/site';
import { estimateFormPath } from '../../data/leadForm';
import { serviceAreas } from '../../data/serviceAreas';
import { services } from '../../data/services';
import { stormDamageFaqs } from '../../data/stormDamageFaqs';
import { breadcrumbSchema, combineSchemas, faqPageSchema, serviceSchema } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const schema = combineSchemas(
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: 'Storm Damage', path: '/services/storm-damage' },
  ]),
  serviceSchema('storm-damage'),
  faqPageSchema(stormDamageFaqs),
);
---

<BaseLayout
  title="Emergency Storm Damage Tree Service in Austin, TX"
  description="Emergency storm damage tree service in Austin, Round Rock, Bee Cave & Lakeway: hazardous limbs, fallen trees, roof clearance. Call (512) 749-8615."
  schema={schema}
>
  <PageBanner
    eyebrow="Emergency storm response"
    title="Storm Damage Tree Service in Austin, TX"
    description="After high winds, hail, or ice storms, broken branches and fallen trees need help right away. Blue Ox Tree Care comes out for dangerous tree problems across the Austin area."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services' },
      { name: 'Storm Damage', path: '/services/storm-damage' },
    ]}
  >
    <div slot="actions" class="mt-6 flex flex-col gap-4 sm:flex-row">
      <a
        href={`tel:${site.phoneTel}`}
        class="btn-primary px-6 py-3 text-center"
      >
        Call Now: {site.phone}
      </a>
      <a
        href={withBase(estimateFormPath)}
        class="rounded-md border-2 border-white px-6 py-3 text-center font-semibold text-white transition hover:bg-white/10"
      >
        Ask Us to Call You
      </a>
    </div>
  </PageBanner>

  <section class="border-b border-ox-navy/10 bg-ox-navy py-6 text-white">
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center gap-2 px-4 text-center sm:flex-row sm:gap-6">
      <p class="font-semibold text-ox-gold">Storm emergency line</p>
      <a href={`tel:${site.phoneTel}`} class="text-2xl font-bold hover:underline">
        {site.phone}
      </a>
      <p class="text-sm text-white/80">Austin · Round Rock · Bee Cave · Lakeway</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          <h2 class="mb-4 text-2xl font-bold text-ox-navy">After a storm: safety first</h2>
          <div class="mb-10 space-y-4 text-ox-navy/90">
            <p>
              Central Texas storms bring straight-line winds, hail, and sometimes ice. They can leave
              limbs hanging, trunks split, and trees across driveways or on roofs. Stay away from
              damaged trees until a pro checks how much force is held in the wood and how steady the
              tree is. Downed power lines need the power company. A limb that looks still may not be
              safe to cut.
            </p>
            <p>
              Torn bark and jagged breaks let in insects and fungi that cause rot. Removing dangerous
              limbs soon and making clean pruning cuts protects the rest of the tree. It also lowers the
              chance that more of the tree breaks in the weeks after the storm.
            </p>
          </div>

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">When to call us right away</h2>
          <ul class="mb-10 space-y-2">
            {[
              'A tree or large limb is on your home, garage, fence, or car',
              'A broken limb is hanging over a walkway, patio, or driveway you need to use',
              'A tree blocks your main door or the way in for emergency crews',
              'A split trunk or lifted roots mean the tree could fall soon',
              'The storm left big, damaged limbs over your roof or play areas',
            ].map((item) => (
              <li class="flex items-start gap-2 text-ox-navy/90">
                <span class="check-mark mt-1">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">What our storm response includes</h2>
          <ul class="mb-10 space-y-2">
            {[
              'Making dangerous trees safe and lowering broken limbs with care',
              'Removing fallen trees from buildings, fences, and yards',
              'Clearing roofs and buildings, using ropes when needed',
              'A tree health and risk check by ISA certified arborists after the storm',
              'Full cleanup and haul-away',
            ].map((item) => (
              <li class="flex items-start gap-2 text-ox-navy/90">
                <span class="check-mark mt-1">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <h2 class="mb-4 text-2xl font-bold text-ox-navy">Insurance and documentation</h2>
          <div class="mb-10 space-y-4 text-ox-navy/90">
            <p>
              Homeowner's insurance may pay for tree removal when a covered building is damaged.
              Policies vary a lot. When it is safe, take photos before cleanup starts. Call your
              insurance company soon, and keep your bills. We give you clear records of the work we
              did. We are not insurance adjusters, and we can't promise what your policy will cover.
            </p>
            <p>
              After a storm, Travis Berlin (ISA BCMA, RM-7612B) and Lacy Berlin (ISA Certified
              Arborist, RM-8632A) can check whether your other trees are stable or need more care.
              They can also write up a risk report for your records.
            </p>
          </div>

          <div class="callout-panel">
            <h2 class="mb-3 text-xl font-bold text-ox-navy">Central Texas Notes</h2>
            <ul class="space-y-3 text-sm text-ox-navy/80">
              <li>
                Ice storms and high winds often damage live oaks and pecans in Austin and Round Rock.
                A quick check helps keep a hurt tree from breaking more later.
              </li>
              <li>
                Oak wilt is a disease that kills oaks. If a storm wounds an oak during the months when
                oak wilt spreads, the cut may need paint and careful timing. See our{' '}
                <a href={withBase('/guides/oak-wilt-austin')} class="link-body">
                  oak wilt guide
                </a>{' '}
                to learn more.
              </li>
              <li>
                A protected tree that a storm damaged may still need City of Austin review before you
                remove it. See our{' '}
                <a
                  href={withBase('/guides/austin-protected-heritage-trees')}
                  class="link-body"
                >
                  protected & heritage tree guide
                </a>
                .
              </li>
              <li>
                For the city's curbside brush and bulk rules after cleanup, see our{' '}
                <a href={withBase('/guides/austin-bulk-brush-pickup')} class="link-body">
                  Austin bulk trash & brush pickup guide
                </a>
                .
              </li>
            </ul>
          </div>
        </div>

        <aside class="space-y-6">
          <div class="sidebar-card">
            <h2 class="sidebar-heading">Emergency Contact</h2>
            <a
              href={`tel:${site.phoneTel}`}
              class="btn-primary mb-4 block px-4 py-3 text-center text-xl"
            >
              {site.phone}
            </a>
            <p class="mb-6 text-sm text-ox-navy/70">
              We are licensed and insured for dangerous tree work. We have no storefront. We come to
              you.
            </p>

            <h2 class="sidebar-heading">Areas We Serve</h2>
            <ul class="mb-6 space-y-2">
              {serviceAreas.map((area) => (
                <li>
                  <a href={withBase(`/service-areas/${area.slug}`)} class="link-aside">
                    Tree care in {area.name}
                  </a>
                </li>
              ))}
            </ul>

            <h2 class="sidebar-heading">Related Services</h2>
            <ul class="space-y-2">
              {services
                .filter((s) => s.slug !== 'storm-damage')
                .map((s) => (
                  <li>
                    <a href={withBase(`/services/${s.slug}`)} class="link-aside">
                      {s.shortTitle}
                    </a>
                  </li>
                ))}
              <li class="border-t border-ox-navy/10 pt-3">
                <a href={withBase('/services')} class="link-aside font-semibold">All services →</a>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <FAQSection heading="Storm Damage FAQ" items={stormDamageFaqs} />

  <CTABanner
    heading="Storm damage on your property?"
    subtext="Call now for emergency tree help in Austin, Round Rock, Bee Cave, and Lakeway."
  />
</BaseLayout>
