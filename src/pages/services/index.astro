---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/services';
import { breadcrumbSchema } from '../../lib/schema';
---

<BaseLayout
  title="Tree Care Services in Austin, TX"
  description="Full-service tree care in Austin, Round Rock & Bee Cave. Trimming, removal, stump grinding, oak wilt, fire mitigation & more. ISA certified arborists."
  schema={breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ])}
>
  <PageBanner
    title="Tree Care Services"
    description="Professional arborist services for Central Texas homeowners and property managers."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services' },
    ]}
  />

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
