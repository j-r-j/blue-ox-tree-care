---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import SidebarCTA from '../../components/SidebarCTA.astro';
import { site } from '../../data/site';
import { estimateFormPath } from '../../data/leadForm';
import { serviceAreas } from '../../data/serviceAreas';
import { services, getService } from '../../data/services';
import {
  breadcrumbSchema,
  combineSchemas,
  serviceSchema,
  videoObjectSchema,
} from '../../lib/schema';
import { withBase } from '../../lib/paths';

const service = getService('pest-disease')!;

const videoPoster = withBase('/videos/pest-disease-care-poster.jpg');
const videoSrc = withBase('/videos/pest-disease-care.mp4');
const videoLabel = 'Organic pest and disease treatment by Blue Ox Tree Care';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.shortTitle, path: '/services/pest-disease' },
];

const schema = combineSchemas(
  breadcrumbSchema(breadcrumbs),
  serviceSchema('pest-disease'),
  videoObjectSchema({
    name: videoLabel,
    description:
      'A look at the organic pest and disease treatments Blue Ox Tree Care makes in house for Central Texas trees: a soil treatment and a contact spray.',
    thumbnailUrl: `${site.url}${videoPoster}`,
    contentUrl: `${site.url}${videoSrc}`,
    uploadDate: '2024-06-01',
  }),
);
---

<BaseLayout title={service.title} description={service.metaDescription} schema={schema}>
  <PageBanner
    ctas
    eyebrow="Organic tree care"
    title={service.pageTitle}
    description={service.intro}
    breadcrumbs={breadcrumbs}
  />

  <section class="bg-ox-navy py-12 text-white md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid items-start gap-10 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <h2 class="mb-4 text-3xl font-bold text-white">
            Organic treatments we make in house
          </h2>
          <div class="space-y-4 text-white/90">
            <p>
              Lacy Berlin makes every organic pest and disease treatment in house. She mixes each
              one for your tree's condition. You won't get a one-size-fits-all spray off a store
              shelf.
            </p>
            <p>
              Our soil treatment adds helpful microbes to the soil around the roots. We call this
              soil inoculation. It works through the whole tree against pests, fungi, and bacteria.
              We pair it with our organic spray for pests and germs on the bark and leaves.
            </p>
            <p class="text-sm text-white/75">
              Results depend on the kind of tree, the timing, and how sick it already is. We check
              each tree honestly and tell you what to expect before we treat it.
            </p>
          </div>
        </div>

        <figure class="video-frame">
          <div class="video-frame-inner">
            <video
              controls
              playsinline
              preload="metadata"
              poster={videoPoster}
              title={videoLabel}
              aria-label={videoLabel}
            >
              <source src={videoSrc} type="video/mp4" />
              Your browser can't play this video. Call {site.phone} to learn about our organic pest
              and disease treatments.
            </video>
          </div>
          <figcaption class="px-4 py-3 text-center text-sm text-white/70">
            In-house organic pest &amp; disease care · Austin, TX
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 lg:max-w-xl">
        <h2 class="mb-4 text-2xl font-bold text-white">What We Offer</h2>
        <ul class="space-y-2">
          {service.highlights.map((item) => (
            <li class="flex items-start gap-2 text-white/90">
              <span class="check-mark mt-1">✓</span>
              {item}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${site.phoneTel}`} class="btn-primary px-6 py-3 text-center">
            Call {site.phone}
          </a>
          <a
            href={withBase(estimateFormPath)}
            class="rounded-md border-2 border-ox-gold px-6 py-3 text-center font-semibold text-ox-gold transition hover:bg-ox-gold/10"
          >
            Get a Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          <div class="mb-8 space-y-4 text-ox-navy/90">
            {service.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {service.localNotes && service.localNotes.length > 0 && (
            <div class="callout-panel">
              <h2 class="mb-3 text-xl font-bold text-ox-navy">Central Texas Notes</h2>
              <ul class="space-y-3">
                {service.localNotes.map((note) => (
                  <li class="text-sm text-ox-navy/80">{note}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <aside class="space-y-6">
          <SidebarCTA />
          <div class="sidebar-card">
            <h2 class="sidebar-heading">Areas We Serve</h2>
            <ul class="mb-6 space-y-2">
              {serviceAreas.map((area) => (
                <li>
                  <a href={withBase(`/service-areas/${area.slug}`)} class="link-aside">
                    Tree care in {area.name}
                  </a>
                </li>
              ))}
            </ul>
            <h2 class="sidebar-heading">Related Services</h2>
            <ul class="space-y-2">
              {services
                .filter((s) => s.slug !== 'pest-disease')
                .map((s) => (
                  <li>
                    <a href={withBase(`/services/${s.slug}`)} class="link-aside">
                      {s.shortTitle}
                    </a>
                  </li>
                ))}
              <li class="border-t border-ox-navy/10 pt-3">
                <a href={withBase('/services')} class="link-aside font-semibold">All services →</a>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Questions about tree pests or disease?"
    subtext="Call us, or ask for a free estimate for organic treatment at your Austin-area home."
    contactLabel="Get a Free Estimate"
  />
</BaseLayout>
