---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { site } from '../../data/site';
import { serviceAreas } from '../../data/serviceAreas';
import { services, getService } from '../../data/services';
import {
  breadcrumbSchema,
  combineSchemas,
  serviceSchema,
  videoObjectSchema,
} from '../../lib/schema';
import { withBase } from '../../lib/paths';

const service = getService('pest-disease')!;

const videoPoster = withBase('/videos/pest-disease-care-poster.jpg');
const videoSrc = withBase('/videos/pest-disease-care.mp4');
const videoLabel = 'Organic pest and disease treatment — Blue Ox Tree Care';

const schema = combineSchemas(
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: service.shortTitle, path: '/services/pest-disease' },
  ]),
  serviceSchema('pest-disease'),
  videoObjectSchema({
    name: videoLabel,
    description:
      'Overview of Blue Ox Tree Care organic, in-house pest and disease treatments for Central Texas trees — soil inoculation and contact spray methods.',
    thumbnailUrl: `${site.url}${videoPoster}`,
    contentUrl: `${site.url}${videoSrc}`,
    uploadDate: '2024-06-01',
  }),
);
---

<BaseLayout title={service.title} description={service.metaDescription} schema={schema}>
  <PageBanner
    eyebrow="A New Dawn of Tree Care"
    title={service.pageTitle}
    description={service.intro}
  />

  <section class="bg-ox-navy py-12 text-white md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid items-start gap-10 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <h2 class="mb-4 text-3xl font-bold text-white">
            In-house brews &amp; soil-inoculating technology
          </h2>
          <div class="space-y-4 text-white/90">
            <p>
              Lacy Berlin formulates every organic pest and disease treatment in house — custom
              blended for your tree's condition, not a one-size-fits-all spray from a shelf.
            </p>
            <p>
              Our soil-inoculating technology supports root-zone biology while addressing pests,
              fungi, and bacteria systemically. It pairs with our organic contact spray for
              topical pests and surface pathogens.
            </p>
            <p class="text-sm text-white/75">
              Outcomes depend on species, timing, and how far decline has progressed — we assess
              each tree honestly and set realistic expectations before treatment.
            </p>
          </div>
        </div>

        <figure class="video-frame">
          <div class="video-frame-inner">
            <video
              controls
              playsinline
              preload="metadata"
              poster={videoPoster}
              title={videoLabel}
              aria-label={videoLabel}
            >
              <source src={videoSrc} type="video/mp4" />
              Your browser does not support embedded video. Call {site.phone} to learn about our
              organic pest and disease treatments.
            </video>
          </div>
          <figcaption class="px-4 py-3 text-center text-sm text-white/70">
            In-house organic pest &amp; disease care · Austin, TX
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 lg:max-w-xl">
        <h2 class="mb-4 text-2xl font-bold text-white">What We Offer</h2>
        <ul class="space-y-2">
          {service.highlights.map((item) => (
            <li class="flex items-start gap-2 text-white/90">
              <span class="check-mark mt-1">✓</span>
              {item}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${site.phoneTel}`} class="btn-primary px-6 py-3 text-center">
            Call {site.phone}
          </a>
          <a
            href={withBase('/contact')}
            class="rounded-md border-2 border-ox-gold px-6 py-3 text-center font-semibold text-ox-gold transition hover:bg-ox-gold/10"
          >
            Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="md:col-span-2">
          <div class="mb-8 space-y-4 text-ox-navy/90">
            {service.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {service.localNotes && service.localNotes.length > 0 && (
            <div class="callout-panel">
              <h2 class="mb-3 text-xl font-bold text-ox-navy">Central Texas Notes</h2>
              <ul class="space-y-3">
                {service.localNotes.map((note) => (
                  <li class="text-sm text-ox-navy/80">{note}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <aside>
          <div class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
            <h3 class="mb-3 font-semibold text-ox-navy">Service Areas</h3>
            <ul class="mb-6 space-y-2">
              {serviceAreas.map((area) => (
                <li>
                  <a href={withBase(`/service-areas/${area.slug}`)} class="link-aside">
                    {area.name}
                  </a>
                </li>
              ))}
            </ul>
            <h3 class="mb-3 font-semibold text-ox-navy">Related Services</h3>
            <ul class="space-y-2">
              {services
                .filter((s) => s.slug !== 'pest-disease')
                .slice(0, 4)
                .map((s) => (
                  <li>
                    <a href={withBase(`/services/${s.slug}`)} class="link-aside">
                      {s.shortTitle}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Questions about tree pests or disease?"
    subtext="Call for a consultation or request a free estimate for organic treatment on your Austin-area property."
    contactLabel="Free Estimate"
  />
</BaseLayout>
