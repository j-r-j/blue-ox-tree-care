---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { site } from '../../data/site';
import { breadcrumbSchema, combineSchemas, personSchemas } from '../../lib/schema';
import { withBase } from '../../lib/paths';

const ownerPhotos: Record<string, { src: string; alt: string }> = {
  'travis-berlin': {
    src: withBase('/team/travis-berlin.jpg'),
    alt: 'Travis Berlin, ISA Board Certified Master Arborist',
  },
  'lacy-berlin': {
    src: withBase('/team/lacy-berlin.jpg'),
    alt: 'Lacy Berlin, ISA Certified Arborist',
  },
};

const ownerBadges: Record<string, { src: string; alt: string } | undefined> = {
  'travis-berlin': { src: withBase('/badges/bcma-badge.png'), alt: 'ISA Board Certified Master Arborist badge' },
  'lacy-berlin': {
    src: withBase('/badges/isa-certified-arborist.jpg'),
    alt: 'ISA Certified Arborist badge',
  },
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Arborists', path: '/arborists' },
];
---

<BaseLayout
  title="Meet Our ISA Certified Arborists | Austin, TX"
  description="Travis Berlin (ISA BCMA, RM-7612B) and Lacy Berlin (ISA Certified Arborist, RM-8632A), co-owners of Blue Ox Tree Care serving the Austin metro. Call (512) 749-8615."
  schema={combineSchemas(breadcrumbSchema(breadcrumbs), personSchemas())}
>
  <PageBanner
    title="Our Arborists"
    description="Family-owned tree care led by ISA certified arborists. You work directly with Travis and Lacy Berlin."
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="grid gap-8 md:grid-cols-2">
        {site.owners.map((owner) => (
          <article class="overflow-hidden rounded-lg border border-ox-navy/10 bg-white shadow-sm">
            <a href={withBase(`/arborists/${owner.id}`)} class="block">
              <div class="aspect-[4/3] overflow-hidden bg-ox-cream">
                <img
                  src={ownerPhotos[owner.id].src}
                  alt={ownerPhotos[owner.id].alt}
                  width="600"
                  height="450"
                  class="h-full w-full object-cover object-top transition hover:opacity-95"
                  loading="lazy"
                />
              </div>
            </a>
            <div class="p-6">
              <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                  <h2 class="mb-1 text-xl font-bold text-ox-navy">
                    <a href={withBase(`/arborists/${owner.id}`)} class="hover:text-ox-blue">
                      {owner.name}
                    </a>
                  </h2>
                  <p class="text-sm font-medium text-ox-blue">{owner.title}</p>
                </div>
                {ownerBadges[owner.id] && (
                  <img
                    src={ownerBadges[owner.id]!.src}
                    alt={ownerBadges[owner.id]!.alt}
                    width="40"
                    height="58"
                    class="h-14 w-auto shrink-0 object-contain"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="mb-3 text-sm font-semibold text-ox-navy/70">{owner.credentials}</p>
              <p class="mb-4 text-sm text-ox-navy/85">{owner.bio.slice(0, 220)}…</p>
              <a href={withBase(`/arborists/${owner.id}`)} class="link-aside font-medium">
                Full bio →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABanner heading="Work with certified arborists" subtext="Call for a free estimate anywhere in our Austin metro service area." />
</BaseLayout>
