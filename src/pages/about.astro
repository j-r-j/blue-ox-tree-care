---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageBanner from '../components/PageBanner.astro';
import { site, aboutContent } from '../data/site';
import { breadcrumbSchema, combineSchemas, personSchemas } from '../lib/schema';
---

<BaseLayout
  title="About Our Austin Arborists | ISA Certified Tree Care"
  description="Meet Travis & Lacy Berlin — ISA certified arborists serving Austin, TX. BCMA RM-7612B & Certified Arborist RM-8632A. Disneyland & Salida experience. Family-owned tree care."
  schema={combineSchemas(
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personSchemas(),
  )}
>
  <PageBanner title="About Blue Ox Tree Care" description={aboutContent.intro} />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="mb-12 grid gap-8 md:grid-cols-2">
        {site.owners.map((owner) => (
          <article class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm" itemscope itemtype="https://schema.org/Person">
            <div class="mb-4 flex h-32 items-center justify-center rounded-md bg-ox-cream">
              <span class="text-4xl font-bold text-ox-blue">{owner.name.charAt(0)}</span>
            </div>
            <h2 class="mb-1 text-xl font-bold text-ox-navy" itemprop="name">{owner.name}</h2>
            <p class="mb-2 text-sm font-medium text-ox-blue" itemprop="jobTitle">{owner.title}</p>
            <p class="mb-3 text-sm font-semibold text-ox-navy/70">{owner.credentials}</p>
            <p class="text-sm text-ox-navy/85" itemprop="description">{owner.bio}</p>
          </article>
        ))}
      </div>

      <div class="prose prose-ox max-w-none space-y-6 text-ox-navy/90">
        <h2 class="text-2xl font-bold text-ox-navy">Our Story</h2>
        <p>{aboutContent.story}</p>
        <p>{aboutContent.disneylandNote}</p>

        <h2 class="text-2xl font-bold text-ox-navy">Our History in Salida, Colorado</h2>
        <p>{aboutContent.salidaHistory}</p>

        <h2 class="text-2xl font-bold text-ox-navy">Our Approach</h2>
        <p>{aboutContent.approach}</p>
      </div>
    </div>
  </section>

  <CTABanner heading="Work with certified arborists" subtext="Contact Blue Ox Tree Care for tree care in the Austin metro." />
</BaseLayout>
