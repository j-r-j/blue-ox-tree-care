---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PageBanner from '../components/PageBanner.astro';
import { site, aboutContent } from '../data/site';
import { breadcrumbSchema, combineSchemas, personSchemas } from '../lib/schema';
import { withBase } from '../lib/paths';

const ownerPhotos: Record<string, { src: string; alt: string }> = {
  'travis-berlin': {
    src: withBase('/team/travis-berlin.jpg'),
    alt: 'Travis Berlin, ISA Board Certified Master Arborist and co-owner of Blue Ox Tree Care',
  },
  'lacy-berlin': {
    src: withBase('/team/lacy-berlin.jpg'),
    alt: 'Lacy Berlin, ISA Certified Arborist and co-owner of Blue Ox Tree Care',
  },
};

const aboutLinks = [
  { label: 'Our arborists', href: '/arborists', text: 'Learn about Travis and Lacy\'s training and work history.' },
  { label: 'What to expect', href: '/what-to-expect', text: 'How estimates, scheduling, payment, and storm help work.' },
  { label: 'Tree care FAQ', href: '/faq', text: 'Quick answers to common Austin tree questions.' },
];

const ownerBadges: Record<string, { src: string; alt: string } | undefined> = {
  'travis-berlin': { src: withBase('/badges/bcma-badge.png'), alt: 'ISA Board Certified Master Arborist badge' },
  'lacy-berlin': {
    src: withBase('/badges/isa-certified-arborist.jpg'),
    alt: 'ISA Certified Arborist badge',
  },
};
---

<BaseLayout
  title="About Us | Family-Owned Austin Arborists"
  description="Meet Travis and Lacy Berlin, the family behind Blue Ox Tree Care in Austin, TX. Travis is an ISA BCMA. Lacy is an ISA Certified Arborist."
  schema={combineSchemas(
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personSchemas(),
  )}
>
  <PageBanner title="About Blue Ox Tree Care" description={aboutContent.intro} breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]} />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <div class="mb-12 grid gap-8 md:grid-cols-2">
        {site.owners.map((owner) => (
          <article class="overflow-hidden rounded-lg border border-ox-navy/10 bg-white shadow-sm" itemscope itemtype="https://schema.org/Person">
            <div class="p-6 pt-8">
              <div class="mx-auto mb-6 aspect-square w-full max-w-[280px] overflow-hidden rounded-full bg-ox-cream">
                <img
                  src={ownerPhotos[owner.id].src}
                  alt={ownerPhotos[owner.id].alt}
                  width="280"
                  height="280"
                  class="h-full w-full object-cover object-top"
                  loading="lazy"
                  itemprop="image"
                />
              </div>
              <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                  <h2 class="mb-1 text-xl font-bold text-ox-navy" itemprop="name">
                    <a href={withBase(`/arborists/${owner.id}`)} class="hover:text-ox-blue-dark">{owner.name}</a>
                  </h2>
                  <p class="text-sm font-medium text-ox-blue-dark" itemprop="jobTitle">{owner.title}</p>
                </div>
                {ownerBadges[owner.id] && (
                  <img
                    src={ownerBadges[owner.id]!.src}
                    alt={ownerBadges[owner.id]!.alt}
                    width="40"
                    height="58"
                    class="h-14 w-auto shrink-0 object-contain"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="mb-3 text-sm font-semibold text-ox-navy/70">{owner.credentials}</p>
              <p class="text-sm text-ox-navy/85" itemprop="description">{owner.bio}</p>
              <a href={withBase(`/arborists/${owner.id}`)} class="link-aside mt-3 inline-block text-sm font-medium">
                {owner.name.split(' ')[0]}'s full profile →
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="space-y-6 text-ox-navy/90">
        <h2 class="text-2xl font-bold text-ox-navy">Our Story</h2>
        <p>{aboutContent.story}</p>
        <p>{aboutContent.disneylandNote}</p>

        <h2 class="text-2xl font-bold text-ox-navy">Our History in Salida, Colorado</h2>
        <p>{aboutContent.salidaHistory}</p>

        <h2 class="text-2xl font-bold text-ox-navy">Our Approach</h2>
        <p>{aboutContent.approach}</p>
      </div>

      <nav aria-labelledby="about-more" class="mt-12 border-t border-ox-navy/10 pt-8">
        <h2 id="about-more" class="mb-4 text-2xl font-bold text-ox-navy">Get to know us</h2>
        <ul class="grid gap-4 sm:grid-cols-3">
          {aboutLinks.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                class="block h-full rounded-lg border border-ox-navy/10 bg-white p-5 shadow-sm transition hover:border-ox-gold hover:shadow-md"
              >
                <span class="mb-1 block font-semibold text-ox-navy">{link.label} →</span>
                <span class="block text-sm text-ox-navy/75">{link.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <CTABanner heading="Work with certified arborists" subtext="Get a free estimate for tree care anywhere in the Austin area." />
</BaseLayout>
