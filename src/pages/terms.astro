---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
import { withBase } from '../lib/paths';

const lastUpdated = 'October 9, 2026';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Terms', path: '/terms' },
];
---

<BaseLayout
  title="Terms of Use"
  description="Simple terms for using the Blue Ox Tree Care website."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <PageBanner title="Terms" description={`Last updated ${lastUpdated}`} breadcrumbs={breadcrumbs} />

  <section class="py-12">
    <div class="legal-copy mx-auto max-w-3xl px-4">
      <p>
        These terms cover your use of this website, run by {site.legalName} ("{site.name}," "we,"
        "us"). By using this site, you agree to them. Read our{' '}
        <a href={withBase('/privacy')}>Privacy Policy</a> to see how we handle your information.
      </p>

      <h2>Estimates and website information</h2>
      <p>
        The information on this site is general. It is not a quote or a promise about any tree.
        Prices, scope, and timing for your job are set in the estimate we give you after we see your
        property.
      </p>

      <h2>Using this site</h2>
      <p>
        Please do not misuse this site or send false information through our forms. The words,
        photos, and logos on this site belong to {site.legalName} or are used with permission.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these terms. We will post the new version here and update the date at the top.
      </p>

      <h2>Contact us</h2>
      <p>
        Questions? Call <a href={`tel:${site.phoneTel}`}>{site.phone}</a> or email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
