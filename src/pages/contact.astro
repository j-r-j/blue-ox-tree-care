---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import { breadcrumbSchema, combineSchemas, localBusinessSchema } from '../lib/schema';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Contact Blue Ox Tree Care | Austin, TX"
  description="Contact Blue Ox Tree Care in Austin, TX. Call (512) 749-8615 or email for tree trimming, removal, and arborist services. Mon–Fri 8 AM – 5 PM."
  schema={combineSchemas(
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    localBusinessSchema(),
  )}
>
  <PageBanner
    title="Contact Us"
    description="Ready to schedule tree care? Call for a free estimate. We serve the Austin metro and come to your property."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]}
  >
    <p slot="actions" class="mt-4">
      <a href={`tel:${site.phoneTel}`} class="text-lg font-semibold text-ox-gold hover:underline">
        Call {site.phone}
      </a>
    </p>
  </PageBanner>

  <section class="py-10 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 lg:grid-cols-5">
      <div
        id="estimate"
        class="rounded-lg border border-ox-navy/10 bg-white p-5 shadow-sm sm:p-8 lg:col-span-3"
      >
        <h2 class="mb-1 text-2xl font-bold text-ox-navy md:text-3xl">Get a Free Estimate</h2>
        <p class="mb-6 text-ox-navy/80">It takes about one minute. The estimate is free.</p>
        <div class="mb-6 border-b border-ox-navy/10 pb-6">
          <HowItWorks />
        </div>
        <LeadForm />
      </div>

      <div class="lg:col-span-2">
        <h2 class="mb-6 text-2xl font-bold text-ox-navy">Get in Touch</h2>
        <dl class="space-y-4">
          <div>
            <dt class="label-accent">Phone</dt>
            <dd class="mt-1">
              <a href={`tel:${site.phoneTel}`} class="text-xl font-bold text-ox-navy hover:text-ox-blue">
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label-accent">Email</dt>
            <dd class="mt-1 space-y-1">
              <p>
                <a href={`mailto:${site.email}`} class="text-ox-navy hover:text-ox-blue">
                  {site.email}
                </a>
              </p>
              <p>
                <a href={`mailto:${site.emailArborists}`} class="text-ox-navy hover:text-ox-blue">
                  {site.emailArborists}
                </a>
              </p>
            </dd>
          </div>
          <div>
            <dt class="label-accent">Hours</dt>
            <dd class="mt-1 text-ox-navy/80">{site.hours.display}</dd>
          </div>
          <div>
            <dt class="label-accent">Service Area</dt>
            <dd class="mt-1 text-ox-navy/80">
              Austin, Round Rock, Bee Cave, Lakeway & surrounding Central Texas communities.{' '}
              {site.serviceAreaNote}
            </dd>
          </div>
          <div>
            <dt class="label-accent">New customers</dt>
            <dd class="mt-1 text-sm text-ox-navy/80">
              <a href={withBase('/what-to-expect')} class="link-body">What to expect</a>: estimate flow, timeline, payment, and credentials.
            </dd>
          </div>
          <div>
            <dt class="label-accent">Instagram</dt>
            <dd class="mt-1">
              <a href={site.instagram} class="text-ox-navy hover:text-ox-blue" target="_blank" rel="noopener noreferrer">
                @blueoxtreecare
              </a>
            </dd>
          </div>
          <div>
            <dt class="label-accent">Google reviews</dt>
            <dd class="mt-1 text-sm text-ox-navy/80">
              {reviews.rating.toFixed(1)} stars · {reviews.count} reviews on Google.{' '}
              <a href={site.googleProfile} class="link-body" target="_blank" rel="noopener noreferrer">
                Read reviews
              </a>
              {' · '}
              <a href={site.googleWriteReview} class="link-body" target="_blank" rel="noopener noreferrer">
                Write a review
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
