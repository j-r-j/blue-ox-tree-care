---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { breadcrumbSchema, combineSchemas, localBusinessSchema } from '../lib/schema';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Contact Blue Ox Tree Care | Austin, TX"
  description="Contact Blue Ox Tree Care in Austin, TX. Call (512) 749-8615 or email for tree trimming, removal, and arborist services. Mon–Fri 8 AM – 5 PM."
  schema={combineSchemas(
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    localBusinessSchema(),
  )}
>
  <PageBanner
    title="Contact Us"
    description="Ready to schedule tree care? Call for a free estimate. We serve the Austin metro and come to your property."
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]}
  />

  <section class="py-16">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2">
      <div>
        <h2 class="mb-6 text-2xl font-bold text-ox-navy">Get in Touch</h2>
        <dl class="space-y-4">
          <div>
            <dt class="label-accent">Phone</dt>
            <dd class="mt-1">
              <a href={`tel:${site.phoneTel}`} class="text-xl font-bold text-ox-navy hover:text-ox-blue">
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label-accent">Email</dt>
            <dd class="mt-1 space-y-1">
              <p>
                <a href={`mailto:${site.email}`} class="text-ox-navy hover:text-ox-blue">
                  {site.email}
                </a>
              </p>
              <p>
                <a href={`mailto:${site.emailArborists}`} class="text-ox-navy hover:text-ox-blue">
                  {site.emailArborists}
                </a>
              </p>
            </dd>
          </div>
          <div>
            <dt class="label-accent">Hours</dt>
            <dd class="mt-1 text-ox-navy/80">{site.hours.display}</dd>
          </div>
          <div>
            <dt class="label-accent">Service Area</dt>
            <dd class="mt-1 text-ox-navy/80">
              Austin, Round Rock, Bee Cave, Lakeway & surrounding Central Texas communities.
              {site.serviceAreaNote}
            </dd>
          </div>
          <div>
            <dt class="label-accent">New customers</dt>
            <dd class="mt-1 text-sm text-ox-navy/80">
              <a href={withBase('/what-to-expect')} class="link-body">What to expect</a>: estimate flow, timeline, payment, and credentials.
            </dd>
          </div>
          <div>
            <dt class="label-accent">Instagram</dt>
            <dd class="mt-1">
              <a href={site.instagram} class="text-ox-navy hover:text-ox-blue" target="_blank" rel="noopener noreferrer">
                @blueoxtreecare
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-ox-navy/10 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-xl font-bold text-ox-navy">Request an Estimate</h2>
        <form
          action={`mailto:${site.email}?subject=Tree Care Estimate Request`}
          method="GET"
          class="space-y-4"
        >
          <div>
            <label for="name" class="mb-1 block text-sm font-medium text-ox-navy">Name</label>
            <input
              type="text"
              id="name"
              name="body"
              placeholder="Your name"
              class="input-field"
            />
          </div>
          <div>
            <label for="phone" class="mb-1 block text-sm font-medium text-ox-navy">Phone</label>
            <input
              type="tel"
              id="phone"
              placeholder="(512) 749-8615"
              class="input-field"
            />
          </div>
          <div>
            <label for="message" class="mb-1 block text-sm font-medium text-ox-navy">Message</label>
            <textarea
              id="message"
              rows="4"
              placeholder="Describe your tree care needs, property location, and preferred contact time."
              class="input-field"
            ></textarea>
          </div>
          <p class="text-xs text-ox-navy/60">
            This form opens your email client. For faster service, call {site.phone}.
          </p>
          <button
            type="submit"
            class="btn-primary w-full px-6 py-3"
          >
            Send via Email
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
